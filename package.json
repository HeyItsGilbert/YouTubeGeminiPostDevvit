{
  "private": true,
  "name": "youtube-gemini",
  "version": "0.3.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "predeploy": "npm run models:sync && npm run type-check",
    "deploy": "devvit upload",
    "models:sync": "dotenv -e .env -- node scripts/sync-gemini-models.mjs",
    "dev": "dotenv -e .env -- devvit playtest",
    "login": "devvit login",
    "launch": "devvit publish --public",
    "type-check": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@devvit/start": "0.15.2",
    "@devvit/web": "0.15.2",
    "@hono/node-server": "^2.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "devvit": "0.15.2",
    "dotenv-cli": "11.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
